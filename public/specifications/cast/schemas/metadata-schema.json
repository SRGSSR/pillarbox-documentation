{
    "$id": "https://github.com/SRGSSR/pillarbox-documentation/blob/main/public/specifications/cast/schemas/metadata-schema.json",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "blockedSegments": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
                "required": [
                    "blockReason",
                    "endTime",
                    "identifier",
                    "startTime"
                ],
                "properties": {
                    "blockReason": {
                        "type": "string",
                        "minLength": 1
                    },
                    "endTime": {
                        "type": "number"
                    },
                    "identifier": {
                        "type": "string",
                        "minLength": 1
                    },
                    "startTime": {
                        "type": "number"
                    }
                }
            }
        },
        "chapters": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
                "required": [
                    "endTime",
                    "identifier",
                    "posterUrl",
                    "startTime",
                    "title"
                ],
                "properties": {
                    "endTime": {
                        "type": "number"
                    },
                    "identifier": {
                        "type": "string",
                        "minLength": 1
                    },
                    "posterUrl": {
                        "type": "string",
                        "minLength": 1
                    },
                    "startTime": {
                        "type": "number"
                    },
                    "title": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        },
        "timeRanges": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
                "required": [
                    "endTime",
                    "startTime",
                    "type"
                ],
                "properties": {
                    "endTime": {
                        "type": "number"
                    },
                    "startTime": {
                        "type": "number"
                    },
                    "type": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        }
    },
    "required": [
    ]
}
