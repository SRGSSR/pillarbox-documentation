{
    "$id": "https://github.com/SRGSSR/pillarbox-documentation/blob/main/public/specifications/standard-connector/schemas/metadata-schema.json",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "chapters": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
                "required": [
                    "endTime",
                    "startTime",
                    "title"
                ],
                "properties": {
                    "endTime": {
                        "type": "number"
                    },
                    "identifier": {
                        "type": "string",
                        "minLength": 1
                    },
                    "posterUrl": {
                        "type": "string",
                        "minLength": 1
                    },
                    "startTime": {
                        "type": "number"
                    },
                    "title": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        },
        "customData": {
            "type": "object",
            "properties": {
            },
            "required": [
            ]
        },
        "description": {
            "type": "string",
            "minLength": 1
        },
        "drm": {
            "type": "object",
            "properties": {
                "certificateUrl": {
                    "type": "string",
                    "minLength": 1
                },
                "keySystem": {
                    "type": "string",
                    "minLength": 1
                },
                "licenseUrl": {
                    "type": "string",
                    "minLength": 1
                },
                "multisession": {
                    "type": "boolean"
                }
            },
            "required": [
                "keySystem",
                "licenseUrl"
            ]
        },
        "episodeNumber": {
            "type": "number"
        },
        "identifier": {
            "type": "string",
            "minLength": 1
        },
        "posterUrl": {
            "type": "string",
            "minLength": 1
        },
        "seasonNumber": {
            "type": "number"
        },
        "source": {
            "type": "object",
            "properties": {
                "audioFragmentFormat": {
                    "type": "string",
                    "minLength": 1
                },
                "mimeType": {
                    "type": "string",
                    "minLength": 1
                },
                "type": {
                    "type": "string",
                    "minLength": 1
                },
                "url": {
                    "type": "string",
                    "minLength": 1
                },
                "videoFragmentFormat": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "required": [
                "url"
            ]
        },
        "subtitle": {
            "type": "string",
            "minLength": 1
        },
        "subtitles": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
                "required": [
                    "kind",
                    "label",
                    "language",
                    "url"
                ],
                "properties": {
                    "kind": {
                        "type": "string",
                        "minLength": 1
                    },
                    "label": {
                        "type": "string",
                        "minLength": 1
                    },
                    "language": {
                        "type": "string",
                        "minLength": 1
                    },
                    "url": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        },
        "timeRanges": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
                "required": [
                    "endTime",
                    "startTime",
                    "type"
                ],
                "properties": {
                    "endTime": {
                        "type": "number"
                    },
                    "startTime": {
                        "type": "string",
                        "minLength": 1
                    },
                    "type": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        },
        "title": {
            "type": "string",
            "minLength": 1
        },
        "version": {
            "type": "number"
        },
        "viewport": {
            "type": "string",
            "minLength": 1
        }
    },
    "required": [
    ]
}